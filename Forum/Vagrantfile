# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Ubuntu 26.04 LTS: the newest bento box (amd64 and arm64; VirtualBox, VMware, Parallels, QEMU).
  config.vm.box = "bento/ubuntu-26.04"
  # Host ports come from soulcraft's dev block (3100-3149); 5000 belongs to AirPlay Receiver on a Mac.
  # The apps listen on $PORT, 3100 by default.
  config.vm.network "forwarded_port", guest: 3100, host: 3100, host_ip: "127.0.0.1"
  config.vm.network "forwarded_port", guest: 3101, host: 3101, host_ip: "127.0.0.1"
  config.vm.network "forwarded_port", guest: 3102, host: 3102, host_ip: "127.0.0.1"

  # Work around disconnected virtual network cable.
  config.vm.provider "virtualbox" do |vb|
    vb.customize ["modifyvm", :id, "--cableconnected1", "on"]
  end

  config.vm.provision "shell", inline: <<-SHELL
    apt-get -qqy update
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" upgrade

    apt-get -qqy install make gcc curl zip unzip postgresql

    # Python 3.15 in a virtualenv from uv: Ubuntu's python3 is older, and PEP 668 blocks a system-wide pip.
    su vagrant -c 'curl -LsSf https://astral.sh/uv/install.sh | sh'
    su vagrant -c '~/.local/bin/uv venv --python 3.15 ~/venv'
    su vagrant -c '~/.local/bin/uv pip install --python ~/venv flask packaging redis passlib flask-httpauth sqlalchemy flask-sqlalchemy psycopg2-binary bleach requests'
    grep -q 'venv/bin/activate' /home/vagrant/.bashrc || echo 'source ~/venv/bin/activate' >> /home/vagrant/.bashrc

    su postgres -c 'createuser -dRS vagrant'
    su vagrant -c 'createdb'
    su vagrant -c 'createdb news'
    su vagrant -c 'createdb forum'
    su vagrant -c 'psql forum -f /vagrant/forum/forum.sql'

    vagrantTip="[35m[1mThe shared directory is located at /vagrant\\nTo access your shared files: cd /vagrant[m"
    echo -e $vagrantTip > /etc/motd

    wget https://download.redis.io/redis-stable.tar.gz
    tar xvzf redis-stable.tar.gz
    cd redis-stable
    make
    make install

    echo "Done installing your virtual machine!"
  SHELL
end
